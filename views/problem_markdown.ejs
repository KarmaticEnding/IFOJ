<% this.title = problem.title + ' - 题面源码'; %>
<% include header %>
<style>
  #statement-markdown {
    margin: 0;
    padding: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: 'Fira Mono', 'Noto Sans CJK SC', monospace;
    font-size: 14px;
    line-height: 1.75;
    tab-size: 4;
  }
</style>
<div class="padding">
  <h1 class="ui header">#<%= problem.id %>. <%= problem.title %> · 题面源码</h1>
  <a class="ui button" href="<%= backUrl %>" style="margin-bottom: 20px; ">返回题目</a>
  <div class="ui segment" style="padding: 0; ">
    <pre id="statement-markdown"><code><%= markdownSource %></code></pre>
  </div>
</div>
<% include footer %>
