<% this.title='个人计划'; this.active='plan'; %>
<% include header %>
<link rel="stylesheet" href="/self/plan.css?v=3">
<div id="plan-page" data-user="<%= target.id %>" data-csrf="<%= csrf %>" data-editable="<%= canEdit?'1':'0' %>" data-admin="<%= user&&user.is_admin?'1':'0' %>" data-server-time="<%= Date.now() %>" data-start="<%= start %>" data-end="<%= end %>">
 <table class="ui celled small very compact selectable table plan-table" aria-label="<%= target.username %>的个人计划">
  <colgroup><col style="width:11.43%"><col style="width:34.285%"><col style="width:34.285%"><col style="width:20%"></colgroup>
  <thead><tr class="center aligned"><th>日期</th><th>计划描述</th><th>完成情况</th><th>调整、补充和评语</th></tr></thead>
  <tbody id="plan-start"><tr class="plan-navigation"><td colspan="4"><a href="/schedule/<%= target.id %>?start=<%= previous %>" data-direction="earlier">更早的计划</a></td></tr></tbody>
  <tbody id="plan-rows"><% include plan_rows %></tbody>
  <tbody id="plan-end"><tr class="plan-navigation"><td colspan="4"><a href="/schedule/<%= target.id %>?start=<%= next %>" data-direction="later">更晚的计划</a></td></tr></tbody>
 </table><div id="plan-navigation-status" role="status" aria-live="polite"></div>
</div>
<% if(canEdit){ %>
<div class="ui modal plan" id="plan-editor">
 <div class="header">编辑计划</div>
 <div class="scrolling content"><div id="plan-edit-date"></div><form class="ui form" id="plan-form">
  <div class="field"><label for="plan-description">计划描述</label><textarea id="plan-description" name="description" rows="5" spellcheck="false"></textarea><div id="plan-description-lock" hidden>当天及以前的计划描述仅管理员可修改。</div></div>
  <div class="field"><label for="plan-completion">完成情况</label><textarea id="plan-completion" name="completion" rows="5" spellcheck="false"></textarea></div>
  <div class="field"><label for="plan-comment">调整、补充和评语</label><textarea id="plan-comment" name="comment" rows="5" spellcheck="false"></textarea></div>
 </form><div id="plan-save-status" role="status" aria-live="polite"></div></div>
 <div class="actions"><button type="button" class="ui positive button">确定</button><button type="button" class="ui cancel button">取消</button></div>
</div>
<% } %>
<script src="/self/plan.js?v=3"></script>
<% include footer %>
